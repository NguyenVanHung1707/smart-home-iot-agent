# ============================================
# AI20K Project — Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- LLM Configuration ----
OPENAI_API_KEY=sk-your-key-here
MODEL_NAME=qwen2.5-3b-instruct-q4_k_m.gguf
LLAMA_MODEL_FILE=qwen2.5-3b-instruct-q4_k_m.gguf
LLM_TOOL_TRANSPORT=homeassistant_protocol
LLM_LOCAL_GENERIC_TOOL_PROTOCOL_ENABLED=true
LLM_LOCAL_GENERIC_TOOL_GRAMMAR_ENABLED=true
LLM_LOCAL_TOOL_RETRIEVAL_ENABLED=false
LLM_LOCAL_PROTOCOL_GRAMMAR_ENABLED=false
LLM_LOCAL_ONLY=true
LLAMA_BASE_URL=http://llama:8080/v1
LLM_ENABLED=true
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=12
LLM_MAX_RETRIES=0
LLM_MAX_TOOL_CALL_ITERATIONS=3
# Or use other providers:
# ANTHROPIC_API_KEY=
# GOOGLE_API_KEY=

# ---- Database (PostgreSQL default) ----
DATABASE_URL=postgresql://homing_user:homing_password@postgres:5432/homing_db
# For SQLite (standalone/dev), use:
# DATABASE_URL=sqlite:///./data/app.db

# ---- Vector Store ----
CHROMA_PERSIST_DIR=./data/chroma
# Or Pinecone:
# PINECONE_API_KEY=
# PINECONE_ENVIRONMENT=

# ---- App Config ----
APP_NAME=Homing Hub
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
CORS_ORIGINS=https://lophocso.io.vn,http://lophocso.io.vn,http://localhost:3000,http://localhost:5173,http://localhost
RATE_LIMIT_PER_MINUTE=600

# ---- Auth ----
# Set JWT_SECRET in production. If empty in development, the backend generates
# an ephemeral secret and old tokens stop working after restart.
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
USERS_FILE=./data/users.json
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
LOGIN_LOCKOUT_THRESHOLD=10
BOOTSTRAP_ADMIN_EMAIL=admin@homing.dev
BOOTSTRAP_ADMIN_PASSWORD=

# ---- Homing Hub ----
MQTT_ENABLED=false
MQTT_BROKER=mqtt
MQTT_PORT=1883
MQTT_TOPIC_PREFIX=homing
MQTT_QOS=1
MQTT_RETAIN_STATE=true
MQTT_CLIENT_ID=homing-hub
# Set both values and disable anonymous broker access before production use.
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TLS_ENABLED=false

# ---- HiveMQ Cloud Configuration (Serverless Smart Home) ----
# Miễn phí 100 kết nối tại: https://www.hivemq.com/mqtt-cloud-broker/
HIVEMQ_HOST=your-instance.s1.eu.hivemq.cloud
HIVEMQ_PORT=8883
HIVEMQ_WSS_PORT=8884
HIVEMQ_USERNAME=homing_user
HIVEMQ_PASSWORD=your_password

# ---- Xiaozhi Cloud Configuration (AI Voice) ----
# Nền tảng Xiaozhi Cloud: https://xiaozhi.me / https://api.tenclass.net
XIAOZHI_SERVER_URL=wss://api.tenclass.net/v1
XIAOZHI_DEVICE_MAC=
XIAOZHI_TOKEN=

DEVICE_STORAGE_PATH=data/devices.json
REAL_DEVICE_STORAGE_PATH=data/devices_real.json
SIMULATOR_DEVICE_STORAGE_PATH=data/devices.json
VOICE_ENABLED=false
ZIPFORMER_ENDPOINT=
ZIPFORMER_HEALTH_ENDPOINT=
ZIPFORMER_MODEL_DIR=models/zipformer/sherpa-onnx-zipformer-vi-int8-2025-04-20
ZIPFORMER_NUM_THREADS=2
WHISPER_ENDPOINT=http://whisper:8080
WHISPER_MODEL=ggml-tiny-q5_1.bin
WHISPER_LANGUAGE=vi
WHISPER_VAD_MODEL=ggml-silero-v6.2.0.bin
PIPER_ENDPOINT=http://piper:5000
PIPER_VOICE=vi_VN-vais1000-medium
SPEECH_TIMEOUT_SECONDS=30
TTS_TIMEOUT_SECONDS=30
VOICE_MAX_AUDIO_SECONDS=20
VOICE_MAX_AUDIO_BYTES=1000000
VOICE_MAX_TTS_CHARS=1000

# ---- LangSmith (AI Logs — Deliverable #4) ----
LANGCHAIN_API_KEY=your-langsmith-key-here
LANGCHAIN_PROJECT=ai20k-agent
LANGCHAIN_TRACING_V2=true

# ---- Logging ----
LOG_LEVEL=INFO

# ---- Agent rollout and queue ----
AGENT_ROLLOUT_MODE=legacy_active
TYPED_INTERPRETER_ENABLED=false
TYPED_INTERPRETER_CAPABILITY_AVAILABLE=false
TYPED_INTERPRETER_ARTIFACT_AVAILABLE=false
AI_MAX_CONCURRENT=1
AI_QUEUE_CAPACITY=10
AI_QUEUE_TIMEOUT_SECONDS=15

# ---- AI Hook Logging (provided by instructor) ----
AI_LOG_SERVER=https://ai-logs.note.transformerlabs.ai/api/ingest
AI_LOG_API_KEY=your-ai-log-key-here
AI_LOG_DIR=.ai-log

# ---- Frontend (if separate) ----
# NEXT_PUBLIC_API_URL=http://localhost:8000

# ---- Cloudflare Tunnel (for domain lophocso.io.vn) ----
# Get your token from Cloudflare Zero Trust > Networks > Tunnels
CLOUDFLARE_TUNNEL_TOKEN=
